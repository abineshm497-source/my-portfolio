# Server Port Configuration
PORT=5000

# Email Delivery Configuration (Nodemailer / SMTP)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Use an App Password if using Gmail (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=abineshm497@gmail.com
SMTP_PASS=your_app_password_here

# Recipient Email for Contact Submissions
RECEIVER_EMAIL=abineshm497@gmail.com

# Web3Forms / Serverless Fallback Access Key (Optional for Option B)
WEB3FORMS_ACCESS_KEY=
